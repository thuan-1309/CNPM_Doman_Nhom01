@{
    ViewData["Title"] = "Dashboard Thư Viện";
}

<style>
    body {
        background-color: #121212;
        color: #ffffff;
    }

    .stat-card {
        background-color: #1e1e1e;
        border-radius: 12px;
        border-left: 5px solid #dc3545;
        padding: 20px;
        transition: transform 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            background-color: #252525;
        }

    .stat-title {
        color: #aaa;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: bold;
        color: #fff;
    }

    .stat-icon {
        font-size: 40px;
        color: rgba(220, 53, 69, 0.3);
        position: absolute;
        right: 20px;
        top: 20px;
    }

    .dashboard-section {
        background-color: #1e1e1e;
        border-radius: 12px;
        padding: 25px;
        margin-top: 30px;
    }

    .title-red-sm {
        color: #dc3545;
        font-weight: bold;
        border-bottom: 2px solid #333;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    .btn-quick-access {
        background: linear-gradient(45deg, #dc3545, #901b27);
        color: white;
        border: none;
        padding: 15px;
        border-radius: 10px;
        width: 100%;
        text-align: left;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
        text-decoration: none;
    }

        .btn-quick-access:hover {
            color: #fff;
            filter: brightness(1.2);
        }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">HỆ THỐNG QUẢN LÝ <span class="text-danger">THƯ VIỆN</span></h2>
        <div class="text-secondary">Thứ Tư, 20/05/2026</div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="stat-card position-relative">
                <div class="stat-title">Tổng đầu sách</div>
                <div class="stat-value">20</div>
                <i class="bi bi-book stat-icon"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card position-relative" style="border-left-color: #ffc107;">
                <div class="stat-title">Độc giả đăng ký</div>
                <div class="stat-value">10</div>
                <i class="bi bi-people stat-icon"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card position-relative" style="border-left-color: #28a745;">
                <div class="stat-title">Đang cho mượn</div>
                <div class="stat-value">5</div>
                <i class="bi bi-journal-check stat-icon"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card position-relative" style="border-left-color: #17a2b8;">
                <div class="stat-title">Sách nhập mới</div>
                <div class="stat-value">14</div>
                <i class="bi bi-plus-circle stat-icon"></i>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="dashboard-section">
                <h5 class="title-red-sm">HOẠT ĐỘNG MƯỢN TRẢ GẦN ĐÂY</h5>
                <div class="table-responsive">
                    <table class="table table-dark table-hover border-secondary">
                        <thead class="text-secondary small">
                            <tr>
                                <th>MÃ PHIẾU</th>
                                <th>ĐỘC GIẢ</th>
                                <th>NGÀY MƯỢN</th>
                                <th>TRẠNG THÁI</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-danger fw-bold">PM00030</td>
                                <td>Bùi Tiến Dũng</td>
                                <td>19/05/2026</td>
                                <td><span class="badge bg-warning text-dark">Đang mượn</span></td>
                            </tr>
                            <tr>
                                <td class="text-danger fw-bold">PM00029</td>
                                <td>Đặng Minh Khôi</td>
                                <td>18/05/2026</td>
                                <td><span class="badge bg-warning text-dark">Đang mượn</span></td>
                            </tr>
                            <tr>
                                <td class="text-danger fw-bold">PM00028</td>
                                <td>Lý Hải Đăng</td>
                                <td>01/05/2026</td>
                                <td><span class="badge bg-success">Đã trả</span></td>
                            </tr>
                            <tr>
                                <td class="text-danger fw-bold">PM00025</td>
                                <td>Nguyễn Văn An</td>
                                <td>22/05/2025</td>
                                <td><span class="badge bg-danger">Quá hạn</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-section">
                <h5 class="title-red-sm">TRUY CẬP NHANH</h5>
                <a asp-controller="PhieuMuon" asp-action="LapPhieu" class="btn-quick-access">
                    <span><i class="bi bi-plus-lg me-2"></i> Lập phiếu mượn mới</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a asp-controller="PhieuMuon" asp-action="TraSach" class="btn-quick-access">
                    <span><i class="bi bi-arrow-return-left me-2"></i> Trả sách</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a href="#" class="btn-quick-access" style="background: #333;">
                    <span><i class="bi bi-person-plus me-2"></i> Thêm độc giả</span>
                    <i class="bi bi-chevron-right"></i>
                </a>

                <div class="p-3 border border-secondary rounded mt-4">
                    <p class="small text-secondary mb-1">Ghi chú thủ thư:</p>
                    <p class="small italic text-light">Kiểm kê sách cũ vào cuối tuần này. Ưu tiên các sách mã MS010 trở đi.</p>
                </div>
            </div>
        </div>
    </div>
</div>