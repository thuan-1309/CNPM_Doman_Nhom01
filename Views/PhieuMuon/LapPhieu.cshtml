@{
    ViewData["Title"] = "Lập Phiếu Mượn Sách";
}

<style>
    /* Custom Dark Mode theo thiết kế */
    body {
        background-color: #121212;
        color: #ffffff;
        font-family: Arial, sans-serif;
    }

    .card-dark {
        background-color: #1e1e1e;
        border: 1px solid #333;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .card-header-dark {
        background-color: transparent;
        border-bottom: 1px solid #333;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .title-red {
        color: #dc3545;
        font-weight: bold;
        text-transform: uppercase;
        margin: 0;
    }

    .section-title {
        color: #dc3545;
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

    .form-control-dark, .form-select-dark {
        background-color: #2b2b2b;
        border: 1px solid #444;
        color: #fff;
    }

        .form-control-dark:focus, .form-select-dark:focus {
            background-color: #333;
            border-color: #dc3545;
            color: #fff;
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }

        .form-control-dark:disabled, .form-control-dark[readonly] {
            background-color: #222;
            color: #888;
        }

    .col-form-label {
        font-size: 14px;
        color: #ccc;
    }

    /* Table Styling */
    .table-dark-custom {
        color: #fff;
        font-size: 14px;
    }

        .table-dark-custom thead th {
            border-bottom: 2px solid #444;
            color: #aaa;
            font-weight: normal;
        }

        .table-dark-custom td {
            border-bottom: 1px solid #333;
            vertical-align: middle;
        }

    .btn-red {
        background-color: #dc3545;
        color: white;
        border: none;
    }

        .btn-red:hover {
            background-color: #c82333;
            color: white;
        }

    .btn-outline-light-custom {
        border: 1px solid #666;
        color: #ccc;
        background: transparent;
    }

        .btn-outline-light-custom:hover {
            background: #333;
            color: #fff;
        }
</style>

<div class="container mt-4 pb-5">
    <div class="card-dark">
        <div class="card-header-dark">
            <h4 class="title-red">LẬP PHIẾU MƯỢN SÁCH</h4>
            <button onclick="history.back()" class="btn btn-sm btn-outline-light-custom"><i class="bi bi-arrow-return-left"></i> Quay lại</button>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6 border-end border-secondary pe-4">
                    <div class="section-title">Thông tin độc giả</div>

                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-3 col-form-label">Mã độc giả</label>
                        <div class="col-sm-9">
                            <select class="form-select form-select-dark form-select-sm" id="cboMaDocGia">
                                <option value="">-- Chọn độc giả --</option>
                                @if (ViewBag.DocGias != null)
                                {
                                    foreach (var dg in ViewBag.DocGias)
                                    {
                                        <option value="@dg.MaDocGia" data-ten="@dg.TenDocGia" data-sdt="@dg.SoDienThoai" data-diachi="@dg.DiaChi">@dg.MaDocGia - @dg.TenDocGia</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-3 col-form-label">Tên độc giả</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-dark form-control-sm" id="txtTenDocGia" readonly>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-3 col-form-label">Số điện thoại</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-dark form-control-sm" id="txtSDT" readonly>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-3 col-form-label">Địa chỉ</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-dark form-control-sm" id="txtDiaChi" readonly>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 ps-4">
                    <div class="section-title">Thông tin phiếu mượn</div>

                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-3 col-form-label">Ngày mượn</label>
                        <div class="col-sm-9">
                            <input type="date" class="form-control form-control-dark form-control-sm" id="txtNgayMuon">
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-3 col-form-label">Hạn trả</label>
                        <div class="col-sm-9">
                            <input type="date" class="form-control form-control-dark form-control-sm" id="txtHanTra">
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-3 col-form-label">Thủ thư</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-dark form-control-sm" value="admin" readonly>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-3 col-form-label">Ghi chú</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control form-control-dark form-control-sm" id="txtGhiChuPhieu" placeholder="Ghi chú (nếu có)">
                        </div>
                    </div>
                </div>
            </div>

            <hr class="border-secondary mt-4 mb-4">

            <div class="section-title">Danh sách sách mượn</div>

            <div class="row mb-3 align-items-center">
                <div class="col-md-5">
                    <div class="d-flex align-items-center">
                        <label class="col-form-label me-3">Sách</label>
                        <select class="form-select form-select-dark form-select-sm" id="cboSach">
                            <option value="">Chọn sách</option>
                            @if (ViewBag.Sachs != null)
                            {
                                foreach (var s in ViewBag.Sachs)
                                {
                                    <option value="@s.MaSach" data-ten="@s.TenSach" data-tacgia="@s.TacGia" data-tonkho="@s.SoLuongTon">@s.MaSach - @s.TenSach</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <label class="col-form-label me-3">Số lượng</label>
                        <input type="number" class="form-control form-control-dark form-control-sm" id="txtSoLuongSach" value="1" min="1" style="width: 80px;">
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <button class="btn btn-sm btn-red" id="btnThemSach">+ Thêm vào danh sách</button>
                </div>
            </div>

            <table class="table table-dark-custom text-center mt-3" id="tblSachMuon">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Mã sách</th>
                        <th class="text-start">Tên sách</th>
                        <th>Tác giả</th>
                        <th>Số lượng</th>
                        <th>Tồn kho</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>

            <div class="text-center mt-3 text-light">
                Tổng số lượng: <span id="lblTongSoLuong">0</span>
            </div>

            <div class="d-flex justify-content-end mt-4 gap-2">
                <button class="btn btn-secondary px-4" onclick="window.location.reload();">X Hủy</button>
                <button class="btn btn-red px-4" id="btnLuuPhieu"><i class="bi bi-save"></i> Lưu phiếu mượn</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Tự động lấy ngày hiện tại cho "Ngày mượn" và +14 ngày cho "Hạn trả"
        const today = new Date();
        const hanTraDate = new Date();
        hanTraDate.setDate(today.getDate() + 14);

        document.getElementById('txtNgayMuon').value = today.toISOString().split('T')[0];
        document.getElementById('txtHanTra').value = hanTraDate.toISOString().split('T')[0];

        // 2. Chức năng: Chọn độc giả hiển thị thông tin chi tiết
        document.getElementById('cboMaDocGia').addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            if (this.value) {
                document.getElementById('txtTenDocGia').value = selectedOption.getAttribute('data-ten');
                document.getElementById('txtSDT').value = selectedOption.getAttribute('data-sdt');
                document.getElementById('txtDiaChi').value = selectedOption.getAttribute('data-diachi');
            } else {
                document.getElementById('txtTenDocGia').value = '';
                document.getElementById('txtSDT').value = '';
                document.getElementById('txtDiaChi').value = '';
            }
        });

        // 3. Chức năng: Thêm sách vào bảng
        let stt = 1;
        document.getElementById('btnThemSach').addEventListener('click', function () {
            const sachSelect = document.getElementById('cboSach');
            const option = sachSelect.options[sachSelect.selectedIndex];
            const soLuong = parseInt(document.getElementById('txtSoLuongSach').value);

            if (!sachSelect.value) return alert("Vui lòng chọn sách!");
            if (soLuong <= 0) return alert("Số lượng phải lớn hơn 0!");

            const tonKho = parseInt(option.getAttribute('data-tonkho'));
            if (soLuong > tonKho) return alert("Số lượng mượn vượt quá tồn kho!");

            const maSach = sachSelect.value;
            const tenSach = option.getAttribute('data-ten');
            const tacGia = option.getAttribute('data-tacgia');

            const tbody = document.querySelector('#tblSachMuon tbody');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${stt++}</td>
                <td>${maSach}</td>
                <td class="text-start">${tenSach}</td>
                <td>${tacGia}</td>
                <td class="sl-sach">${soLuong}</td>
                <td>${tonKho}</td>
                <td>
                    <button class="btn btn-sm btn-red btn-xoa"><i class="bi bi-trash"></i></button>
                </td>
            `;
            tbody.appendChild(tr);
            tinhTongSoLuong();
        });

        // 4. Chức năng: Xóa sách khỏi bảng
        document.querySelector('#tblSachMuon tbody').addEventListener('click', function (e) {
            if (e.target.closest('.btn-xoa')) {
                e.target.closest('tr').remove();
                tinhTongSoLuong();
            }
        });

        function tinhTongSoLuong() {
            let tong = 0;
            document.querySelectorAll('.sl-sach').forEach(td => {
                tong += parseInt(td.innerText);
            });
            document.getElementById('lblTongSoLuong').innerText = tong;
        }

        // 5. Gửi dữ liệu xuống CSDL (Fetch API)
        document.getElementById('btnLuuPhieu').addEventListener('click', function () {
            const maDG = document.getElementById('cboMaDocGia').value;
            const ngayMuon = document.getElementById('txtNgayMuon').value;
            const hanTra = document.getElementById('txtHanTra').value;
            const ghiChu = document.getElementById('txtGhiChuPhieu').value;

            if (!maDG) return alert("Vui lòng chọn độc giả!");

            const rows = document.querySelectorAll('#tblSachMuon tbody tr');
            if (rows.length === 0) return alert("Vui lòng thêm ít nhất 1 sách vào danh sách!");

            let danhSachSach = [];
            rows.forEach(row => {
                danhSachSach.push({
                    MaSach: row.cells[1].innerText,
                    SoLuong: parseInt(row.cells[4].innerText)
                });
            });

            const payload = {
                MaDocGia: maDG, NgayMuon: ngayMuon, HanTra: hanTra, GhiChu: ghiChu, DanhSachSach: danhSachSach
            };

            fetch('/PhieuMuon/LuuPhieuMuon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    alert(data.message);
                    window.location.reload();
                } else alert(data.message);
            });
        });
    });
</script>