@{
    ViewData["Title"] = "Trả Sách";
}

<style>
    body {
        background-color: #121212;
        color: #ffffff;
        font-family: Arial, sans-serif;
    }

    .card-dark {
        background-color: #1e1e1e;
        border: 1px solid #333;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .card-header-dark {
        background-color: transparent;
        border-bottom: 1px solid #333;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .title-red {
        color: #dc3545;
        font-weight: bold;
        text-transform: uppercase;
        margin: 0;
    }

    .section-title {
        color: #dc3545;
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

    .form-control-dark {
        background-color: #2b2b2b;
        border: 1px solid #444;
        color: #fff;
    }

        .form-control-dark:focus {
            background-color: #333;
            border-color: #dc3545;
            color: #fff;
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }

        .form-control-dark:disabled, .form-control-dark[readonly] {
            background-color: #222;
            color: #888;
            border-color: #333;
        }

    .col-form-label {
        font-size: 14px;
        color: #ccc;
    }

    .table-dark-custom {
        color: #fff;
        font-size: 14px;
    }

        .table-dark-custom thead th {
            border-bottom: 2px solid #444;
            color: #aaa;
            font-weight: normal;
        }

        .table-dark-custom td {
            border-bottom: 1px solid #333;
            vertical-align: middle;
        }

    .btn-red {
        background-color: #dc3545;
        color: white;
        border: none;
    }

        .btn-red:hover {
            background-color: #c82333;
            color: white;
        }

    .btn-outline-light-custom {
        border: 1px solid #666;
        color: #ccc;
        background: transparent;
    }

        .btn-outline-light-custom:hover {
            background: #333;
            color: #fff;
        }

    .text-success-custom {
        color: #28a745;
    }
</style>

<div class="container mt-4 pb-5">
    <div class="card-dark">
        <div class="card-header-dark">
            <h4 class="title-red">TRẢ SÁCH</h4>
            <button onclick="history.back()" class="btn btn-sm btn-outline-light-custom"><i class="bi bi-arrow-return-left"></i> Quay lại</button>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-4 border-end border-secondary pe-4">
                    <div class="section-title">Thông tin phiếu mượn</div>

                    <div class="mb-4">
                        <label class="form-label text-light fs-6">Mã phiếu mượn</label>
                        <div class="input-group">
                            <input type="text" class="form-control form-control-dark" id="txtMaPhieuMuon" placeholder="Nhập mã phiếu (VD: PM00028)...">
                            <button class="btn btn-red" id="btnTimKiem">Tìm kiếm</button>
                        </div>
                    </div>

                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-4 col-form-label">Độc giả</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control form-control-dark form-control-sm border-0" id="txtDocGia" readonly>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-4 col-form-label">Ngày mượn</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control form-control-dark form-control-sm border-0" id="txtNgayMuonInfo" readonly>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-4 col-form-label">Hạn trả</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control form-control-dark form-control-sm border-0" id="txtHanTraInfo" readonly>
                        </div>
                    </div>
                </div>

                <div class="col-md-8 ps-4">
                    <div class="section-title">Danh sách sách đang mượn</div>

                    <table class="table table-dark-custom text-center" id="tblSachTra">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã sách</th>
                                <th class="text-start">Tên sách</th>
                                <th>Ngày mượn</th>
                                <th>Hạn trả</th>
                                <th>Tình trạng</th>
                                <th>Quá hạn</th>
                                <th>Tiền phạt</th>
                                <th>Chọn trả</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>

                    <div class="row mt-4 pt-3 border-top border-secondary align-items-center">
                        <div class="col-md-5 d-flex align-items-center">
                            <label class="col-form-label me-3 text-nowrap">Ngày trả</label>
                            <input type="date" class="form-control form-control-dark form-control-sm" id="txtNgayTra">
                        </div>
                        <div class="col-md-7 d-flex align-items-center">
                            <label class="col-form-label me-3 text-nowrap">Ghi chú</label>
                            <input type="text" class="form-control form-control-dark form-control-sm" id="txtGhiChuTra" placeholder="Ghi chú (nếu có)">
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-5 gap-2">
                <button class="btn btn-secondary px-4" onclick="window.location.reload();">X Hủy</button>
                <button class="btn btn-red px-4" id="btnXacNhanTra"><i class="bi bi-check2"></i> Xác nhận trả sách</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById('txtNgayTra').value = new Date().toISOString().split('T')[0];

        // 1. TÌM KIẾM MÃ PHIẾU TỪ CSDL
        document.getElementById('btnTimKiem').addEventListener('click', function() {
            const maPhieu = document.getElementById('txtMaPhieuMuon').value.trim();
            if(!maPhieu) return alert("Vui lòng nhập mã phiếu");

            fetch('/PhieuMuon/TimKiemPhieu?maPhieu=' + maPhieu)
            .then(res => res.json())
            .then(data => {
                const tbody = document.querySelector('#tblSachTra tbody');
                tbody.innerHTML = '';

                if(data.success) {
                    document.getElementById('txtDocGia').value = data.info.TenDocGia || data.info.tenDocGia;
                    document.getElementById('txtNgayMuonInfo').value = data.info.NgayMuon || data.info.ngayMuon;
                    document.getElementById('txtHanTraInfo').value = data.info.HanTra || data.info.hanTra;

                    let stt = 1;
                    data.dsSach.forEach(sach => {
                        let tinhTrang = sach.tinhTrangTra || sach.TinhTrangTra;
                        let maSach = sach.maSach || sach.MaSach;
                        let tenSach = sach.tenSach || sach.TenSach;
                        let ngayMuon = sach.ngayMuon || sach.NgayMuon;
                        let hanTra = sach.hanTra || sach.HanTra;
                        let soNgayTre = sach.soNgayTre ?? sach.SoNgayTre ?? 0;
                        let tienPhat = sach.tienPhat ?? sach.TienPhat ?? 0;

                        let isDaTra = tinhTrang === 'Đã trả';
                        let colorStatus = isDaTra ? 'text-secondary' : 'text-success-custom';

                        tbody.innerHTML += `
                            <tr>
                                <td>${stt++}</td>
                                <td class="ma-sach-cell">${maSach}</td>
                                <td class="text-start">${tenSach}</td>
                                <td>${ngayMuon}</td>
                                <td>${hanTra}</td>
                                <td class="${colorStatus}">${tinhTrang}</td>
                                <td>${soNgayTre > 0 ? soNgayTre + ' ngày' : 'Đúng hạn'}</td>
                                <td>${Number(tienPhat).toLocaleString()}đ</td>
                                <td>
                                    <input class="form-check-input chk-tra" type="checkbox" ${isDaTra ? 'disabled' : ''}>
                                </td>
                            </tr>
                        `;
                    });
                } else {
                    alert(data.message);
                    document.getElementById('txtDocGia').value = '';
                    document.getElementById('txtNgayMuonInfo').value = '';
                    document.getElementById('txtHanTraInfo').value = '';
                }
            });
        });

        // 2. XÁC NHẬN TRẢ SÁCH VỀ CSDL
        document.getElementById('btnXacNhanTra').addEventListener('click', function() {
            const maPhieu = document.getElementById('txtMaPhieuMuon').value.trim();
            const ghiChu = document.getElementById('txtGhiChuTra').value;

            let maSachTra = [];
            document.querySelectorAll('.chk-tra:checked:not(:disabled)').forEach(chk => {
                const tr = chk.closest('tr');
                maSachTra.push(tr.querySelector('.ma-sach-cell').innerText.trim());
            });

            if(maSachTra.length === 0) return alert("Bạn chưa chọn sách nào để trả!");

            fetch('/PhieuMuon/XacNhanTra', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    MaPhieuMuon: maPhieu,
                    GhiChu: ghiChu,
                    MaSachTra: maSachTra
                })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    // Nếu có ngày trễ thì báo phạt, không thì báo trả thành công bình thường
                    let alertMsg = data.message;
                    if(data.soNgayTre > 0){
                         alertMsg += "\nSố ngày trễ: " + data.soNgayTre + "\nTiền phạt: " + data.tienPhat.toLocaleString() + " VNĐ";
                    }
                    alert(alertMsg);

                    // Refresh lại bảng tìm kiếm
                    document.getElementById('btnTimKiem').click();
                } else {
                    alert(data.message);
                }
            });
        });
    });
</script>